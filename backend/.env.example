DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/tienda
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
SECRET_KEY=change_me
ENVIRONMENT=development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# En producci?n usa ?nicamente URLs HTTPS expl?citas, separadas por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ALLOW_ORIGIN_REGEX=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
TRUST_PROXY_HEADERS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=8
RATE_LIMIT_CHECKOUT_PER_MINUTE=20
RATE_LIMIT_EVENTS_PER_MINUTE=120
RATE_LIMIT_PUBLIC_PER_MINUTE=180

# Dev: dejar vacio para usar /uploads/products/<filename>
# Prod: setear URL base de CDN/storage, ej: https://cdn.tudominio.com/products
# PRODUCT_IMAGE_BASE_URL=

# Storage: local o r2. Nunca confirmes claves reales en Git.
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
