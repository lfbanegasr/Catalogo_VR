# ─────────────────────────────────────────────────────────────────────────────
# Backend — Variables de entorno de ejemplo
# Copia este archivo como .env y completa los valores marcados con [REQUERIDO].
# NUNCA confirmes .env en Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ─────────────────────────────────────────────────────────────
# [REQUERIDO] Cadena de conexión PostgreSQL.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/tienda

# Pool de conexiones (valores razonables para producción)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# ── Seguridad y JWT ───────────────────────────────────────────────────────────
# [REQUERIDO en producción] Mínimo 32 caracteres aleatorios.
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_32_char_secret

ENVIRONMENT=development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS y hosts permitidos ───────────────────────────────────────────────────
# En producción usa únicamente URLs HTTPS, separadas por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ALLOW_ORIGIN_REGEX=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
TRUST_PROXY_HEADERS=false

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=8
RATE_LIMIT_CHECKOUT_PER_MINUTE=20
RATE_LIMIT_EVENTS_PER_MINUTE=120
RATE_LIMIT_PUBLIC_PER_MINUTE=180

# ── Almacenamiento de imágenes ────────────────────────────────────────────────
# Dev: dejar vacío para usar rutas relativas /uploads/<subfolder>/<filename>
# Prod: URL base del CDN o del origen público, ej: https://cdn.tudominio.com
PUBLIC_ASSET_BASE_URL=
PRODUCT_IMAGE_BASE_URL=

# Backend de almacenamiento: "local" (por defecto) o "r2"
STORAGE_BACKEND=local

# Directorio de uploads (relativo al backend/ o ruta absoluta)
UPLOADS_DIR=uploads

# Cloudflare R2 — solo si STORAGE_BACKEND=r2
# NUNCA confirmes claves reales en Git.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=

# ── Pipeline de optimización de imágenes ─────────────────────────────────────
# Tamaño máximo de archivo de entrada (en bytes). Por defecto: 10 MB.
IMAGE_MAX_INPUT_BYTES=10485760

# Dimensiones máximas permitidas en píxeles.
IMAGE_MAX_WIDTH=4096
IMAGE_MAX_HEIGHT=4096

# Límite de píxeles totales (anti-decompression bomb). Por defecto: 25 MP.
IMAGE_MAX_PIXELS=25000000

# Calidad WebP de salida (0-100). 82 ofrece buen equilibrio calidad/peso.
IMAGE_WEBP_QUALITY=82

# Desactivar conversión a WebP (útil solo para tests o casos excepcionales).
IMAGE_OPTIMIZE_ENABLED=true

# ── Recuperación de contraseña ────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_URL_BASE=http://localhost:5174/admin/reset-password

# [SOLO DESARROLLO] Retornar el token en la respuesta del endpoint (NUNCA en prod)
PASSWORD_RESET_DEBUG_RETURN_TOKEN=false

# ── SMTP para emails de recuperación ─────────────────────────────────────────
# Si SMTP_HOST está vacío, el sistema no enviará correos reales.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ── Inteligencia artificial (PDF catalog) ─────────────────────────────────────
CATALOG_AI_ENABLED=false
CATALOG_AI_MODEL=microsoft/Florence-2-base
CATALOG_AI_ALLOW_DOWNLOAD=false

# ── Variables del frontend (Vite) — para referencia ──────────────────────────
# Estas variables van en frontend/.env.local y frontend-admin/.env.local
# (no en este archivo)
#
# VITE_API_BASE=http://127.0.0.1:8000
# VITE_DEFAULT_STORE_SLUG=demo-accesorios
#
# Para páginas legales del catálogo público:
# VITE_LEGAL_OPERATOR_NAME=Tu Empresa
# VITE_LEGAL_COUNTRY=Colombia
# VITE_LEGAL_CONTACT_EMAIL=privacidad@tudominio.com
