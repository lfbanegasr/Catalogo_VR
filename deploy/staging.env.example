ENVIRONMENT=staging
DATABASE_URL=postgresql+psycopg2://staging_user:staging_password@staging-db.example:5432/catalogovr_staging
SECRET_KEY=generate_a_different_random_secret_for_staging
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=https://staging-catalog.example.com,https://staging-admin.example.com
CORS_ALLOW_ORIGIN_REGEX=
ALLOWED_HOSTS=staging-api.example.com
TRUST_PROXY_HEADERS=true
RATE_LIMIT_ENABLED=true

PASSWORD_RESET_DEBUG_RETURN_TOKEN=false
PASSWORD_RESET_URL_BASE=https://staging-admin.example.com/admin/reset-password
PUBLIC_ASSET_BASE_URL=https://staging-api.example.com
UPLOADS_DIR=/data/uploads
